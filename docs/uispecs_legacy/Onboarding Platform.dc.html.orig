          ink: i < a.stepsDone ? '#4d4a46' : '#b0aba3'
        }))
      })),
      timeline: [
        { time: 'Today 09:04', text: 'Maria Kessler commented on Verification', meta: 'Comment · visible to customer', dot: dot(ACC, 7) },
        { time: 'Today 08:12', text: 'Notification sent: UBO Declaration overdue', meta: 'Email + in-app · to Anke Brandt', dot: dot(AMB, 7) },
        { time: 'Yest. 16:20', text: 'KYC Pack v3 approved by Jonas Devries', meta: 'Document approval · Compliance', dot: dot(GRN, 7) },
        { time: 'Yest. 11:47', text: 'Document Collection reached 75%', meta: 'Milestone progress · automatic', dot: dot(GRN, 7) },
        { time: '11 Aug 14:02', text: 'SLA v2 sent for signature', meta: 'Agreement status → Awaiting signature', dot: dot(ACC, 7) },
        { time: '08 Aug 10:30', text: 'Technical Setup marked blocked by Verification', meta: 'Dependency added by workflow', dot: dot(RED, 7) },
        { time: '21 Jul 17:10', text: 'MSA v3 signed by both parties', meta: 'Agreement · countersigned by Legal', dot: dot(GRN, 7) },
        { time: '08 Jul 09:00', text: 'Sales approval granted at €240k ACV', meta: 'Approval · J. Devries', dot: dot(GRN, 7) },
        { time: '04 Jul 12:41', text: 'Customer created from web registration', meta: 'System · enriched from registry', dot: dot('#d6d1c9', 7) }
      ],

      stages: S.stages.map((s, i) => Object.assign({}, s, {
        n: String(i + 1).padStart(2, '0'),
        select: () => this.setState({ selStage: i }),
        up: this.moveStage(i, -1),
        down: this.moveStage(i, 1),
        remove: this.removeStage(i),
        rowStyle: 'display: flex; align-items: flex-start; gap: 14px; background: #fff; border: 1px solid ' + (i === selIdx ? ACC : '#e6e3dd') + '; border-radius: 11px; padding: 12px 16px; cursor: pointer; box-shadow: ' + (i === selIdx ? '0 0 0 3px oklch(0.95 0.03 274)' : 'none') + ';'
      })),
      addStage: this.addStage,
      sel: {
        name: sel.name,
        fields: [
          { label: 'Stage name', value: sel.name },
          { label: 'Responsible department', value: sel.dept },
          { label: 'SLA target', value: sel.sla },
          { label: 'Entry condition', value: selIdx === 0 ? 'Registration submitted' : 'Previous stage complete' },
          { label: 'Write scope (record-level)', value: sel.scope || 'Owner only' },
          { label: 'Notification template', value: 'stage_entered_default' }
        ],
        branches: sel.branch
          ? [{ text: 'If ' + sel.branch + ' → ' + sel.branchTo, meta: 'Else ' + sel.branchElse + ' · evaluated on stage exit' }]
          : [{ text: 'No conditions — always continues to the next stage.', meta: 'Add one to route cases down a different path' }],
        toggles: [
          { label: 'Requires approval', on: !!sel.approval },
          { label: 'Auto-advance when tasks done', on: !!sel.auto },
          { label: 'Visible in customer portal', on: true }
        ].map(t => ({
          label: t.label,
          track: 'width: 34px; height: 20px; border-radius: 20px; padding: 2px; flex: 0 0 34px; display: flex; justify-content: ' + (t.on ? 'flex-end' : 'flex-start') + '; background: ' + (t.on ? ACC : '#ddd9d2') + ';',
          knob: 'width: 16px; height: 16px; border-radius: 50%; background: #fff;'
        }))
      },

      ranges: ['30 days', '90 days', '12 months'].map(r => ({ label: r, pick: () => this.setState({ range: r }), style: this.chipStyle(S.range === r) })),
      exports: ['PDF', 'Excel', 'CSV'],
      trend: trendVals.map((v, i) => ({
        value: v,
        label: ['Q1 25', 'Q2 25', 'Q3 25', 'Q4 25', 'Q1 26', 'Q2 26', 'Jul', 'Aug'][i],
        barStyle: 'width: 100%; height: ' + Math.round(v / maxT * 100) + '%; border-radius: 6px 6px 3px 3px; background: ' + (i > 5 ? ACC : 'oklch(0.86 0.04 274)') + ';'
      })),
      bottlenecks: bnk.map(b => ({
        stage: b.stage,
        label: b.days + 'd / SLA ' + b.sla + 'd',
        ink: b.days > b.sla ? RED : GRN,
        barStyle: bar(Math.min(100, Math.round(b.days / 12 * 100)), b.days > b.sla ? RED : GRN, 8),
        slaStyle: 'position: absolute; top: 0; bottom: 0; left: ' + Math.round(b.sla / 12 * 100) + '%; width: 2px; background: #191a1e; opacity: 0.5;'
      })),
      reportCards: [
        { title: 'Department performance', rows: [{ k: 'Legal', v: '96% on SLA', ink: GRN }, { k: 'Technical', v: '94% on SLA', ink: GRN }, { k: 'Compliance', v: '71% on SLA', ink: RED }, { k: 'Support', v: '98% on SLA', ink: GRN }] },
        { title: 'Completion rates', rows: [{ k: 'Reached go live', v: '86%', ink: '#4d4a46' }, { k: 'Stalled > 30d', v: '9%', ink: AMB }, { k: 'Cancelled', v: '5%', ink: '#4d4a46' }, { k: 'First-time doc approval', v: '64%', ink: AMB }] },
        { title: 'Pipeline value', rows: [{ k: 'In verification', v: '€1.9M', ink: '#4d4a46' }, { k: 'In technical setup', v: '€2.4M', ink: '#4d4a46' }, { k: 'Ready for go live', v: '€820k', ink: GRN }, { k: 'At risk', v: '€640k', ink: RED }] }
      ],

      setWeb: () => this.setState({ portalDevice: 'web' }),
      setMobile: () => this.setState({ portalDevice: 'mobile' }),
      webBtn: this.chipStyle(S.portalDevice === 'web'),
      mobileBtn: this.chipStyle(S.portalDevice === 'mobile'),
      portalWeb: S.portalDevice === 'web',
      portalMobile: S.portalDevice === 'mobile',
      portalSteps: STAGE_NAMES.map((s, i) => {
        const done = i < portalDone, active = i === portalDone || i === portalActive;
        const col = done ? GRN : active ? ACC : '#eae7e1';
        return {
          label: s,
          date: done ? ['04 Jul', '08 Jul', '21 Jul'][i] : active ? 'in progress' : 'upcoming',
          bar: 'height: 5px; border-radius: 3px; background: ' + col + ';',
          mdot: 'width: 11px; height: 11px; border-radius: 50%; margin-top: 4px; background: ' + col + ';',
          ink: done || active ? '#2b2c31' : '#b0aba3'
        };
      }),
      portalAsks: [
        { name: 'UBO Declaration', short: 'UBO form', hint: 'Signed by a company director · overdue 2 days' },
        { name: 'Tax Residency Certificate', short: 'certificate', hint: 'Issued within the last 12 months · due 20 Aug' }
      ],
      portalUpcoming: [
        { date: '20 Aug', title: 'Verification decision', sub: 'Our compliance team · no action needed' },
        { date: '30 Aug', title: 'Technical setup kickoff', sub: 'We will send calendar invites' },
        { date: '09 Sep', title: 'Training sessions', sub: 'Two 90-minute sessions, remote' }
      ],
      mobileTabs: [
        { icon: '◫', label: 'Progress', ink: ACC },
        { icon: '☰', label: 'Tasks', ink: MUT },
        { icon: '⎙', label: 'Documents', ink: MUT },
        { icon: '◔', label: 'Updates', ink: MUT }
      ],
      mobileNotes: [
        'Customers touch this on a phone, usually to answer a request — so uploads are the primary action, not navigation.',
        'Every tap target is at least 44px tall; the upload button is full-width and repeated per requested document.',
        'The roadmap turns vertical on mobile; only stage, state and date survive the cut.',
        'No internal notes, no owner names beyond the single named contact, no task IDs.'
      ],

      decisions: [
        { title: 'One object, many facets', body: 'Tasks, documents, agreements and timeline are tabs on the customer case rather than top-level sections. Nobody works on “documents” in the abstract — they work on a customer.' },
        { title: 'The roadmap is the spine', body: 'The nine-stage journey appears identically in the internal workspace and the portal, so both sides talk about the same picture. Milestones expand in place; nothing opens in a modal.' },
        { title: 'Dashboard sorted by exception', body: 'KPIs sit above a “needs attention” list rather than a wall of charts. The operational question is always “who is stuck”, so that answer is one glance away.' },
        { title: 'Branches as rules, not a canvas', body: 'Conditional routing is expressed as a readable IF/THEN/ELSE line on the stage it belongs to. A node graph would show the same logic and cost an admin who edits an SLA twice a year far more to read.' },
        { title: 'Case, not customer, is the unit of work', body: 'A customer can run several onboardings at once, so every screen below the customer list is scoped to one case, with a switcher rather than a merged view.' },
        { title: 'Portal shows debt, not detail', body: 'The customer view leads with what they owe us and when they go live. Each contact signs in individually and sees only the documents scoped to them.' },
        { title: 'Restrained palette', body: 'One accent for progress, plus green/amber/red reserved strictly for state. Colour always means status, never decoration — dense tables stay readable.' }
      ],
      coverage: [
        { sec: '§5', req: 'Dashboard', where: 'KPI cards, pipeline funnel, attention list, live feed, workload, week', state: 'Designed', st: 'done' },
        { sec: '§6', req: 'Journey workspace', where: 'Customer header + expandable 9-stage roadmap', state: 'Designed', st: 'done' },
        { sec: '§7', req: 'Workflow engine', where: 'Builder: reorder, add, remove, conditional branch rules, versioned migration', state: 'Designed', st: 'done' },
        { sec: '§8', req: 'Task management', where: 'Tasks tab + inline tasks per milestone', state: 'Designed', st: 'done' },
        { sec: '§9', req: 'Agreements', where: 'Agreements tab with lifecycle tracker', state: 'Designed', st: 'done' },
        { sec: '§10', req: 'Documents', where: 'Repository table, upload zone, request tracker', state: 'Designed', st: 'done' },
        { sec: '§11', req: 'Activity timeline', where: 'Timeline tab (immutable audit view)', state: 'Designed', st: 'done' },
        { sec: '§12', req: 'Customer portal', where: 'Portal screen, web + mobile', state: 'Designed', st: 'done' },
        { sec: '§13', req: 'Notifications', where: 'Header panel; channels shown as config note', state: 'Designed', st: 'done' },
        { sec: '§14', req: 'Reporting', where: 'Reports screen with export actions', state: 'Designed', st: 'done' },
        { sec: '§4/§15', req: 'Roles & RBAC', where: 'Record-level write scope per stage; internal/customer switch', state: 'Designed', st: 'done' },
        { sec: '§12', req: 'Multi-case customers', where: 'Case switcher in workspace; case rows in customer list', state: 'Designed', st: 'done' },
        { sec: '§16', req: 'Dark mode, i18n, WCAG', where: 'Rail theme tweak only; full themes pending', state: 'Partial', st: 'wait' }
      ].map(c => Object.assign({}, c, { pill: PILLS[c.st] })),
      questions: [
        { n: '01', answer: 'Conditional branching is required from day one.', impact: 'Stages in the builder now carry IF/THEN/ELSE rules, shown inline on the stage and editable in the inspector. The journey stays a spine, but the path a case takes is computed, not fixed.' },
        { n: '02', answer: 'A customer can hold multiple concurrent cases.', impact: 'The workspace is scoped to a case, with a case switcher under the customer name; the customer list shows case counts and lists each case as its own row.' },
        { n: '03', answer: 'Permissions are record-level, scoped not just by role.', impact: 'Each stage declares a write scope (“Compliance on this case”, “Owner only”) rather than a global role. Twelve role definitions collapse into role × record scope.' },
        { n: '04', answer: 'Auth is per contact; document visibility is granular.', impact: 'The documents table gained a “Visible to” column and a portal-contacts panel, so a KYC pack can reach the compliance contact without exposing commercials.' },
        { n: '05', answer: 'Freeze by default, with explicit migration as the supported path.', impact: 'Publishing shows how many running cases sit on the old version and routes the admin into a reviewed migration instead of silently re-versioning live work.' }
      ],
      language: [
        { k: 'Type', v: 'Archivo for interface and numerals; IBM Plex Mono for IDs, dates, metrics and labels.' },
        { k: 'Colour', v: 'Warm neutral surfaces (#f7f6f3 / #fff), single indigo accent, status green/amber/red.' },
        { k: 'Density', v: '13px body in tables, 12px secondary, 6px progress bars — built for long lists on 1440px screens.' },
        { k: 'Motion', v: 'Only progress bars, expansion and the live-feed dot animate. Nothing moves that does not report state.' },
        { k: 'Radius', v: '13px cards, 8–9px controls, 5px bars. Nothing fully rounded except avatars and pills.' }
      ]
    };
  }
}

</script>
</body>
</html>
