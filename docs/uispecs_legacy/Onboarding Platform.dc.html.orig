        docs: (docsByM[m.key] || []).map(d => Object.assign({}, d, { pill: PILLS[d.st] })),
        comments: commentsByM[m.key] || []
      });
    });

    const allTasksRaw = [
      { id: 'v1', title: 'Review KYC pack against sanctions list', desc: 'Compliance checklist 4 of 6 complete', milestone: 'Verification', priority: 'High', assignee: 'Compliance', due: '19 Aug', status: 'In Progress', done: false },
