<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #f7f6f3; }
  body { -webkit-font-smoothing: antialiased; }
  a { color: oklch(0.52 0.16 274); text-decoration: none; }
  a:hover { color: oklch(0.42 0.16 274); text-decoration: underline; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: #d9d5ce; border-radius: 8px; border: 3px solid transparent; background-clip: content-box; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes pulseDot { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
</style>
</helmet>

<div style="display: flex; min-height: 100vh; font-family: Archivo, Helvetica, sans-serif; color: #191a1e; background: #f7f6f3;">

  <aside style="width: 244px; flex: 0 0 244px; background: {{ railBg }}; color: {{ railInk }}; display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;">
    <div style="padding: 22px 20px 18px; display: flex; align-items: center; gap: 10px;">
      <div style="width: 26px; height: 26px; border-radius: 7px; background: oklch(0.52 0.16 274); display: grid; place-items: center; font-size: 13px; font-weight: 700; color: #fff;">O</div>
      <div style="display: flex; flex-direction: column; line-height: 1.15;">
        <span style="font-size: 14px; font-weight: 600; letter-spacing: -0.01em;">Onboard OS</span>
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; opacity: 0.5;">acme-industrial</span>
      </div>
    </div>

    <nav style="display: flex; flex-direction: column; gap: 2px; padding: 6px 10px;">
      <sc-for list="{{ nav }}" as="item" hint-placeholder-count="6">
        <button onClick="{{ item.go }}" style="{{ item.style }}" style-hover="opacity: 1; background: rgba(255,255,255,0.07);">
          <span style="width: 16px; text-align: center; font-size: 13px; opacity: 0.85;">{{ item.icon }}</span>
          <span style="flex: 1; text-align: left;">{{ item.label }}</span>
          <sc-if value="{{ item.badge }}" hint-placeholder-val="{{ false }}">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 1px 6px; border-radius: 20px; background: rgba(255,255,255,0.12);">{{ item.badge }}</span>
          </sc-if>
        </button>
      </sc-for>
    </nav>

    <div style="margin-top: auto; padding: 14px 16px 18px; border-top: 1px solid rgba(255,255,255,0.09);">
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.09em; text-transform: uppercase; opacity: 0.45; margin-bottom: 8px;">Viewing as</div>
      <div style="display: flex; gap: 4px; padding: 3px; border-radius: 9px; background: rgba(255,255,255,0.07);">
        <button onClick="{{ setInternal }}" style="{{ roleInternalStyle }}">Internal</button>
        <button onClick="{{ setCustomer }}" style="{{ roleCustomerStyle }}">Customer</button>
      </div>
      <div style="display: flex; align-items: center; gap: 9px; margin-top: 14px;">
        <div style="width: 28px; height: 28px; border-radius: 50%; background: oklch(0.72 0.14 70); color: #191a1e; display: grid; place-items: center; font-size: 11px; font-weight: 600;">MK</div>
        <div style="line-height: 1.25;">
          <div style="font-size: 12.5px; font-weight: 500;">Maria Kessler</div>
          <div style="font-size: 10.5px; opacity: 0.5;">{{ roleLabel }}</div>
        </div>
      </div>
    </div>
  </aside>

  <main style="flex: 1; min-width: 0; display: flex; flex-direction: column;">

    <header style="position: sticky; top: 0; z-index: 30; background: rgba(247,246,243,0.88); backdrop-filter: blur(10px); border-bottom: 1px solid #e6e3dd; padding: 0 28px; height: 60px; display: flex; align-items: center; gap: 18px;">
      <div style="display: flex; align-items: baseline; gap: 9px; min-width: 0;">
        <span style="font-size: 17px; font-weight: 600; letter-spacing: -0.02em; white-space: nowrap;">{{ screenTitle }}</span>
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #75726c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ screenMeta }}</span>
      </div>
      <div style="flex: 1;"></div>
      <div style="display: flex; align-items: center; gap: 8px; padding: 0 11px; height: 34px; border: 1px solid #e6e3dd; background: #fff; border-radius: 9px; width: 230px; color: #75726c;">
        <span style="font-size: 12px;">⌕</span>
        <span style="font-size: 12.5px;">Search customers, tasks…</span>
        <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 1px 5px; border: 1px solid #e6e3dd; border-radius: 4px;">⌘K</span>
      </div>
      <button onClick="{{ toggleNotif }}" style="position: relative; width: 34px; height: 34px; border-radius: 9px; border: 1px solid #e6e3dd; background: #fff; cursor: pointer; font-size: 14px; color: #191a1e;" style-hover="background: #f2f0ec;">
        ◔
        <span style="position: absolute; top: -3px; right: -3px; min-width: 16px; height: 16px; border-radius: 20px; background: oklch(0.57 0.17 25); color: #fff; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; display: grid; place-items: center; padding: 0 3px;">{{ notifCount }}</span>
      </button>
      <button style="height: 34px; padding: 0 14px; border-radius: 9px; border: none; background: oklch(0.52 0.16 274); color: #fff; font-family: Archivo, sans-serif; font-size: 12.5px; font-weight: 500; cursor: pointer;" style-hover="background: oklch(0.45 0.16 274);">New onboarding</button>
    </header>

    <sc-if value="{{ notifOpen }}" hint-placeholder-val="{{ false }}">
      <div style="position: fixed; top: 66px; right: 24px; z-index: 60; width: 348px; background: #fff; border: 1px solid #e6e3dd; border-radius: 14px; box-shadow: 0 18px 44px -18px rgba(25,26,30,0.32); overflow: hidden; animation: fadeUp 0.16s ease both;">
        <div style="padding: 13px 16px; border-bottom: 1px solid #efece7; display: flex; align-items: center;">
          <span style="font-size: 13px; font-weight: 600;">Notifications</span>
          <span style="margin-left: auto; font-size: 11.5px; color: oklch(0.52 0.16 274); cursor: pointer;">Mark all read</span>
        </div>
        <sc-for list="{{ notifications }}" as="n" hint-placeholder-count="4">
          <div style="padding: 12px 16px; border-bottom: 1px solid #f4f2ee; display: flex; gap: 11px; align-items: flex-start;">
            <span style="{{ n.dot }}"></span>
            <div style="min-width: 0;">
              <div style="font-size: 12.5px; line-height: 1.4;">{{ n.text }}</div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f; margin-top: 3px;">{{ n.meta }}</div>
            </div>
          </div>
        </sc-for>
        <div style="padding: 10px 16px; font-size: 11.5px; color: #75726c;">In-app · Email · SMS delivery configured per event</div>
      </div>
    </sc-if>

    <div style="padding: 24px 28px 56px;">

      <sc-if value="{{ isDash }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="Dashboard" style="display: flex; flex-direction: column; gap: 16px;">

          <div style="display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px;">
            <sc-for list="{{ kpis }}" as="k" hint-placeholder-count="4">
              <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 17px;">
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">{{ k.label }}</div>
                <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 9px;">
                  <span style="font-size: 29px; font-weight: 600; letter-spacing: -0.03em; line-height: 1;">{{ k.value }}</span>
                  <span style="{{ k.deltaStyle }}">{{ k.delta }}</span>
                </div>
                <div style="font-size: 11.5px; color: #75726c; margin-top: 7px;">{{ k.sub }}</div>
              </div>
            </sc-for>
          </div>

          <div style="display: grid; grid-template-columns: 1.35fr 1fr; gap: 16px; align-items: start;">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px 20px;">
              <div style="display: flex; align-items: center; margin-bottom: 16px;">
                <span style="font-size: 13.5px; font-weight: 600;">Pipeline by stage</span>
                <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f;">48 active projects</span>
              </div>
              <div style="display: flex; flex-direction: column; gap: 9px;">
                <sc-for list="{{ funnel }}" as="f" hint-placeholder-count="9">
                  <div style="display: grid; grid-template-columns: 132px 1fr 42px; align-items: center; gap: 12px;">
                    <span style="font-size: 12px; color: #4d4a46;">{{ f.stage }}</span>
                    <div style="height: 22px; background: #f4f2ee; border-radius: 5px; overflow: hidden;">
                      <div style="{{ f.barStyle }}"></div>
                    </div>
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; text-align: right; color: #4d4a46;">{{ f.count }}</span>
                  </div>
                </sc-for>
              </div>
            </div>

            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; overflow: hidden;">
              <div style="padding: 16px 18px 12px; display: flex; align-items: center;">
                <span style="font-size: 13.5px; font-weight: 600;">Needs attention</span>
                <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 2px 7px; border-radius: 20px; background: oklch(0.96 0.04 25); color: oklch(0.5 0.17 25);">5 blocked</span>
              </div>
              <sc-for list="{{ attention }}" as="a" hint-placeholder-count="5">
                <div onClick="{{ a.open }}" style="padding: 11px 18px; border-top: 1px solid #f4f2ee; display: flex; gap: 11px; align-items: center; cursor: pointer;" style-hover="background: #faf9f7;">
                  <span style="{{ a.dot }}"></span>
                  <div style="min-width: 0; flex: 1;">
                    <div style="font-size: 12.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ a.name }}</div>
                    <div style="font-size: 11px; color: #75726c;">{{ a.reason }}</div>
                  </div>
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: {{ a.ageColor }};">{{ a.age }}</span>
                </div>
              </sc-for>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; align-items: start;">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 18px 18px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 13px;">
                <span style="font-size: 13.5px; font-weight: 600;">Live activity</span>
                <span style="{{ liveDotStyle }}"></span>
              </div>
              <div style="display: flex; flex-direction: column; gap: 13px;">
                <sc-for list="{{ feed }}" as="e" hint-placeholder-count="5">
                  <div style="display: flex; gap: 10px;">
                    <div style="width: 22px; height: 22px; flex: 0 0 22px; border-radius: 50%; background: #f2f0ec; display: grid; place-items: center; font-size: 9.5px; font-weight: 600; color: #4d4a46;">{{ e.who }}</div>
                    <div style="min-width: 0;">
                      <div style="font-size: 12px; line-height: 1.45; color: #2b2c31;">{{ e.text }}</div>
                      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f; margin-top: 2px;">{{ e.time }}</div>
                    </div>
                  </div>
                </sc-for>
              </div>
            </div>

            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 18px 18px;">
              <div style="font-size: 13.5px; font-weight: 600; margin-bottom: 14px;">Team workload</div>
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <sc-for list="{{ workload }}" as="w" hint-placeholder-count="5">
                  <div>
                    <div style="display: flex; align-items: baseline; margin-bottom: 5px;">
                      <span style="font-size: 12px;">{{ w.team }}</span>
                      <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #75726c;">{{ w.open }}</span>
                    </div>
                    <div style="height: 6px; border-radius: 4px; background: #f4f2ee; overflow: hidden;">
                      <div style="{{ w.barStyle }}"></div>
                    </div>
                  </div>
                </sc-for>
              </div>
            </div>

            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 18px 18px;">
              <div style="display: flex; align-items: center; margin-bottom: 14px;">
                <span style="font-size: 13.5px; font-weight: 600;">This week</span>
                <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f;">Aug 17–21</span>
              </div>
              <div style="display: flex; flex-direction: column; gap: 10px;">
                <sc-for list="{{ week }}" as="d" hint-placeholder-count="4">
                  <div style="display: flex; gap: 12px; align-items: flex-start; padding-bottom: 10px; border-bottom: 1px solid #f4f2ee;">
                    <div style="text-align: center; width: 30px; flex: 0 0 30px;">
                      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #9a968f; text-transform: uppercase;">{{ d.dow }}</div>
                      <div style="font-size: 15px; font-weight: 600; line-height: 1.1;">{{ d.day }}</div>
                    </div>
                    <div style="min-width: 0;">
                      <div style="font-size: 12px; font-weight: 500;">{{ d.title }}</div>
                      <div style="font-size: 11px; color: #75726c; margin-top: 2px;">{{ d.sub }}</div>
                    </div>
                  </div>
                </sc-for>
              </div>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isCustomers }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Customers" style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; gap: 7px; align-items: center;">
            <sc-for list="{{ filters }}" as="f" hint-placeholder-count="4">
              <button onClick="{{ f.pick }}" style="{{ f.style }}">{{ f.label }}</button>
            </sc-for>
            <div style="flex: 1;"></div>
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #9a968f;">{{ rowCount }} shown · sorted by risk</span>
          </div>

          <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; overflow: hidden;">
            <div style="display: grid; grid-template-columns: 2.1fr 1.2fr 1.5fr 1fr 1fr 0.7fr; gap: 14px; padding: 11px 20px; background: #faf9f7; border-bottom: 1px solid #e6e3dd; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">
              <span>Customer</span><span>Stage</span><span>Progress</span><span>Owner</span><span>Due</span><span>Health</span>
            </div>
            <sc-for list="{{ rows }}" as="c" hint-placeholder-count="6">
              <div onClick="{{ c.open }}" style="display: grid; grid-template-columns: 2.1fr 1.2fr 1.5fr 1fr 1fr 0.7fr; gap: 14px; align-items: center; padding: {{ rowPad }} 20px; border-bottom: 1px solid #f4f2ee; cursor: pointer;" style-hover="background: #faf9f7;">
                <div style="display: flex; align-items: center; gap: 11px; min-width: 0;">
                  <div style="{{ c.avatar }}">{{ c.initials }}</div>
                  <div style="min-width: 0;">
                    <div style="font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ c.name }}</div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f;">{{ c.id }} · {{ c.sector }} · {{ c.cases }}</div>
                  </div>
                </div>
                <span style="{{ c.stagePill }}">{{ c.stage }}</span>
                <div style="display: flex; align-items: center; gap: 9px;">
                  <div style="flex: 1; height: 6px; border-radius: 4px; background: #f0eee9; overflow: hidden;">
                    <div style="{{ c.barStyle }}"></div>
                  </div>
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #4d4a46; width: 30px;">{{ c.pct }}</span>
                </div>
                <span style="font-size: 12px; color: #4d4a46;">{{ c.owner }}</span>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #4d4a46;">{{ c.due }}</span>
                <span style="{{ c.healthPill }}">{{ c.health }}</span>
              </div>
            </sc-for>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isWorkspace }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Journey workspace" style="display: flex; flex-direction: column; gap: 16px;">

          <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 20px 22px;">
            <div style="display: flex; gap: 20px; align-items: flex-start;">
              <div style="width: 46px; height: 46px; border-radius: 12px; background: oklch(0.94 0.03 274); color: oklch(0.42 0.16 274); display: grid; place-items: center; font-size: 15px; font-weight: 600;">{{ cust.initials }}</div>
              <div style="min-width: 0; flex: 1;">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                  <span style="font-size: 19px; font-weight: 600; letter-spacing: -0.02em;">{{ cust.name }}</span>
                  <span style="{{ cust.healthPill }}">{{ cust.health }}</span>
                </div>
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #75726c; margin-top: 5px;">{{ cust.meta }}</div>
                <div style="display: flex; align-items: center; gap: 7px; margin-top: 13px; flex-wrap: wrap;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin-right: 3px;">Cases</span>
                  <sc-for list="{{ cases }}" as="c" hint-placeholder-count="3">
                    <button onClick="{{ c.pick }}" style="{{ c.style }}">
                      <span style="{{ c.dot }}"></span>
                      <span>{{ c.name }}</span>
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; opacity: 0.6;">{{ c.id }}</span>
                    </button>
                  </sc-for>
                  <button style="height: 27px; padding: 0 10px; border-radius: 8px; border: 1px dashed #ccc7bf; background: transparent; font-family: Archivo, sans-serif; font-size: 11.5px; color: #75726c; cursor: pointer;" style-hover="border-color: #9a968f;">＋ New case</button>
                </div>
                <div style="display: flex; gap: 26px; margin-top: 16px; flex-wrap: wrap;">
                  <sc-for list="{{ cust.facts }}" as="f" hint-placeholder-count="5">
                    <div>
                      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">{{ f.label }}</div>
                      <div style="font-size: 12.5px; margin-top: 4px; font-weight: 500;">{{ f.value }}</div>
                    </div>
                  </sc-for>
                </div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 34px; font-weight: 600; letter-spacing: -0.03em; line-height: 1;">{{ cust.pct }}</div>
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f; margin-top: 4px;">COMPLETE</div>
                <div style="width: 150px; height: 7px; border-radius: 4px; background: #f0eee9; overflow: hidden; margin-top: 10px;">
                  <div style="{{ cust.barStyle }}"></div>
                </div>
              </div>
            </div>
          </div>

          <div style="display: flex; gap: 3px; border-bottom: 1px solid #e6e3dd;">
            <sc-for list="{{ tabs }}" as="t" hint-placeholder-count="5">
              <button onClick="{{ t.pick }}" style="{{ t.style }}">
                {{ t.label }}
                <sc-if value="{{ t.count }}" hint-placeholder-val="{{ false }}">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; margin-left: 6px; color: #9a968f;">{{ t.count }}</span>
                </sc-if>
              </button>
            </sc-for>
          </div>

          <sc-if value="{{ tabJourney }}" hint-placeholder-val="{{ false }}">
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 2px;">
                <span style="font-size: 12px; color: #75726c;">Workflow</span>
                <span style="font-size: 12px; font-weight: 500;">Standard Enterprise Onboarding v4</span>
                <a href="#" onClick="{{ goWorkflow }}" style="font-size: 12px;">Configure</a>
                <div style="flex: 1;"></div>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f;">Click a milestone to expand</span>
              </div>
              <sc-for list="{{ milestones }}" as="m" hint-placeholder-count="9">
                <div style="{{ m.cardStyle }}">
                  <div onClick="{{ m.toggle }}" style="display: grid; grid-template-columns: 26px 1fr auto; gap: 14px; align-items: center; padding: 14px 18px; cursor: pointer;">
                    <div style="{{ m.dot }}">{{ m.dotGlyph }}</div>
                    <div style="min-width: 0;">
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 13.5px; font-weight: 600;">{{ m.title }}</span>
                        <span style="{{ m.pill }}">{{ m.status }}</span>
                        <sc-if value="{{ m.blockedBy }}" hint-placeholder-val="{{ false }}">
                          <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: oklch(0.5 0.17 25);">blocked by {{ m.blockedBy }}</span>
                        </sc-if>
                      </div>
                      <div style="font-size: 11.5px; color: #75726c; margin-top: 4px;">{{ m.sub }}</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 18px;">
                      <div style="text-align: right;">
                        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #4d4a46;">{{ m.due }}</div>
                        <div style="font-size: 10.5px; color: #9a968f;">{{ m.owner }}</div>
                      </div>
                      <div style="width: 74px; height: 6px; border-radius: 4px; background: #f0eee9; overflow: hidden;">
                        <div style="{{ m.barStyle }}"></div>
                      </div>
                      <span style="{{ m.chevStyle }}">▾</span>
                    </div>
                  </div>
                  <sc-if value="{{ m.open }}" hint-placeholder-val="{{ false }}">
                    <div style="border-top: 1px solid #efece7; padding: 16px 18px 18px 58px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 22px; animation: fadeUp 0.16s ease both;">
                      <div>
                        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin-bottom: 9px;">Tasks</div>
                        <div style="display: flex; flex-direction: column; gap: 7px;">
                          <sc-for list="{{ m.tasks }}" as="t" hint-placeholder-count="3">
                            <div style="display: flex; align-items: center; gap: 10px; padding: 8px 11px; border: 1px solid #efece7; border-radius: 9px; background: #fdfcfb;">
                              <button onClick="{{ t.toggle }}" style="{{ t.box }}">{{ t.check }}</button>
                              <span style="{{ t.titleStyle }}">{{ t.title }}</span>
                              <span style="{{ t.prio }}">{{ t.priority }}</span>
                              <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f;">{{ t.assignee }} · {{ t.due }}</span>
                            </div>
                          </sc-for>
                        </div>
                        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin: 16px 0 9px;">Documents</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                          <sc-for list="{{ m.docs }}" as="d" hint-placeholder-count="2">
                            <div style="display: flex; align-items: center; gap: 8px; padding: 7px 11px; border: 1px solid #efece7; border-radius: 9px; background: #fdfcfb;">
                              <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; padding: 2px 4px; border-radius: 3px; background: #f0eee9; color: #75726c;">{{ d.ext }}</span>
                              <span style="font-size: 12px;">{{ d.name }}</span>
                              <span style="{{ d.pill }}">{{ d.status }}</span>
                            </div>
                          </sc-for>
                        </div>
                      </div>
                      <div>
                        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin-bottom: 9px;">Dependencies</div>
                        <div style="font-size: 12px; color: #4d4a46; line-height: 1.6;">{{ m.deps }}</div>
                        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin: 16px 0 9px;">Comments</div>
                        <sc-for list="{{ m.comments }}" as="c" hint-placeholder-count="2">
                          <div style="display: flex; gap: 9px; margin-bottom: 11px;">
                            <div style="width: 22px; height: 22px; flex: 0 0 22px; border-radius: 50%; background: #f2f0ec; display: grid; place-items: center; font-size: 9px; font-weight: 600; color: #4d4a46;">{{ c.who }}</div>
                            <div>
                              <div style="font-size: 12px; line-height: 1.45; color: #2b2c31;">{{ c.text }}</div>
                              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #9a968f; margin-top: 2px;">{{ c.time }}</div>
                            </div>
                          </div>
                        </sc-for>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px 11px; border: 1px dashed #ddd9d2; border-radius: 9px; font-size: 11.5px; color: #9a968f;">Write a comment… <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px;">@ to mention</span></div>
                      </div>
                    </div>
                  </sc-if>
                </div>
              </sc-for>
            </div>
          </sc-if>

          <sc-if value="{{ tabTasks }}" hint-placeholder-val="{{ false }}">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; overflow: hidden;">
              <div style="display: grid; grid-template-columns: 24px 2.4fr 1fr 1fr 1fr 1fr; gap: 14px; padding: 11px 20px; background: #faf9f7; border-bottom: 1px solid #e6e3dd; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">
                <span></span><span>Task</span><span>Milestone</span><span>Assignee</span><span>Due</span><span>Status</span>
              </div>
              <sc-for list="{{ allTasks }}" as="t" hint-placeholder-count="8">
                <div style="display: grid; grid-template-columns: 24px 2.4fr 1fr 1fr 1fr 1fr; gap: 14px; align-items: center; padding: {{ rowPad }} 20px; border-bottom: 1px solid #f4f2ee;">
                  <button onClick="{{ t.toggle }}" style="{{ t.box }}">{{ t.check }}</button>
                  <div style="min-width: 0;">
                    <div style="{{ t.titleStyle }}">{{ t.title }}</div>
                    <div style="font-size: 11px; color: #9a968f; margin-top: 2px;">{{ t.desc }}</div>
                  </div>
                  <span style="font-size: 11.5px; color: #4d4a46;">{{ t.milestone }}</span>
                  <span style="font-size: 11.5px; color: #4d4a46;">{{ t.assignee }}</span>
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: {{ t.dueColor }};">{{ t.due }}</span>
                  <span style="{{ t.statusPill }}">{{ t.status }}</span>
                </div>
              </sc-for>
            </div>
          </sc-if>

          <sc-if value="{{ tabDocs }}" hint-placeholder-val="{{ false }}">
            <div style="display: grid; grid-template-columns: 1fr 300px; gap: 16px; align-items: start;">
              <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; overflow: hidden;">
                <div style="display: grid; grid-template-columns: 2.2fr 1.1fr 0.7fr 0.9fr 1.3fr 0.9fr; gap: 14px; padding: 11px 20px; background: #faf9f7; border-bottom: 1px solid #e6e3dd; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">
                  <span>Document</span><span>Category</span><span>Version</span><span>Expires</span><span>Visible to</span><span>Status</span>
                </div>
                <sc-for list="{{ documents }}" as="d" hint-placeholder-count="8">
                  <div style="display: grid; grid-template-columns: 2.2fr 1.1fr 0.7fr 0.9fr 1.3fr 0.9fr; gap: 14px; align-items: center; padding: {{ rowPad }} 20px; border-bottom: 1px solid #f4f2ee;">
                    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; padding: 3px 5px; border-radius: 4px; background: #f0eee9; color: #75726c;">{{ d.ext }}</span>
                      <span style="font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ d.name }}</span>
                    </div>
                    <span style="font-size: 11.5px; color: #4d4a46;">{{ d.category }}</span>
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #4d4a46;">{{ d.version }}</span>
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: {{ d.expColor }};">{{ d.expires }}</span>
                    <div style="display: flex; align-items: center; gap: 7px; min-width: 0;">
                      <span style="{{ d.visDot }}"></span>
                      <span style="font-size: 11.5px; color: #4d4a46; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ d.visible }}</span>
                    </div>
                    <span style="{{ d.pill }}">{{ d.status }}</span>
                  </div>
                </sc-for>
              </div>
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <div style="background: #fff; border: 1px dashed #ccc7bf; border-radius: 13px; padding: 26px 18px; text-align: center;">
                  <div style="font-size: 20px; color: #b5b0a7;">↥</div>
                  <div style="font-size: 12.5px; font-weight: 500; margin-top: 8px;">Drop files to upload</div>
                  <div style="font-size: 11px; color: #75726c; margin-top: 4px;">PDF, DOCX, XLSX · max 50 MB · encrypted at rest</div>
                </div>
                <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 18px;">
                  <div style="font-size: 13px; font-weight: 600; margin-bottom: 12px;">Requested from customer</div>
                  <sc-for list="{{ requested }}" as="r" hint-placeholder-count="3">
                    <div style="display: flex; align-items: center; gap: 9px; padding: 8px 0; border-top: 1px solid #f4f2ee;">
                      <span style="{{ r.dot }}"></span>
                      <span style="font-size: 12px;">{{ r.name }}</span>
                      <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f;">{{ r.state }}</span>
                    </div>
                  </sc-for>
                </div>
                <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 18px;">
                  <div style="font-size: 13px; font-weight: 600;">Portal contacts</div>
                  <div style="font-size: 11px; color: #75726c; margin-top: 4px; line-height: 1.5;">Each contact signs in individually; document visibility is set per contact.</div>
                  <sc-for list="{{ contacts }}" as="p" hint-placeholder-count="3">
                    <div style="display: flex; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid #f4f2ee;">
                      <div style="width: 26px; height: 26px; flex: 0 0 26px; border-radius: 50%; background: #f2f0ec; display: grid; place-items: center; font-size: 9.5px; font-weight: 600; color: #4d4a46;">{{ p.initials }}</div>
                      <div style="min-width: 0;">
                        <div style="font-size: 12px; font-weight: 500;">{{ p.name }}</div>
                        <div style="font-size: 10.5px; color: #75726c;">{{ p.role }}</div>
                      </div>
                      <span style="margin-left: auto; {{ p.pill }}">{{ p.access }}</span>
                    </div>
                  </sc-for>
                </div>
              </div>
            </div>
          </sc-if>

          <sc-if value="{{ tabAgreements }}" hint-placeholder-val="{{ false }}">
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px;">
              <sc-for list="{{ agreements }}" as="a" hint-placeholder-count="4">
                <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px;">
                  <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <div style="min-width: 0; flex: 1;">
                      <div style="font-size: 14px; font-weight: 600;">{{ a.title }}</div>
                      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f; margin-top: 4px;">{{ a.meta }}</div>
                    </div>
                    <span style="{{ a.pill }}">{{ a.status }}</span>
                  </div>
                  <div style="display: flex; gap: 6px; margin-top: 16px; align-items: center;">
                    <sc-for list="{{ a.steps }}" as="s" hint-placeholder-count="4">
                      <div style="flex: 1; text-align: center;">
                        <div style="{{ s.bar }}"></div>
                        <div style="font-size: 10px; color: {{ s.ink }}; margin-top: 6px;">{{ s.label }}</div>
                      </div>
                    </sc-for>
                  </div>
                  <div style="display: flex; align-items: center; gap: 14px; margin-top: 18px; padding-top: 14px; border-top: 1px solid #f4f2ee;">
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #75726c;">{{ a.expiry }}</span>
                    <div style="flex: 1;"></div>
                    <span style="font-size: 12px; color: oklch(0.52 0.16 274); cursor: pointer;">Preview</span>
                    <span style="font-size: 12px; color: oklch(0.52 0.16 274); cursor: pointer;">{{ a.action }}</span>
                  </div>
                </div>
              </sc-for>
            </div>
          </sc-if>

          <sc-if value="{{ tabTimeline }}" hint-placeholder-val="{{ false }}">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 22px 24px;">
              <div style="display: flex; align-items: center; margin-bottom: 18px;">
                <span style="font-size: 13.5px; font-weight: 600;">Audit history</span>
                <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f;">Immutable · 214 events · export CSV</span>
              </div>
              <sc-for list="{{ timeline }}" as="e" hint-placeholder-count="9">
                <div style="display: grid; grid-template-columns: 92px 22px 1fr; gap: 14px; align-items: start;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f; text-align: right; padding-top: 3px;">{{ e.time }}</span>
                  <div style="display: flex; flex-direction: column; align-items: center; height: 100%;">
                    <span style="{{ e.dot }}"></span>
                    <span style="flex: 1; width: 1px; background: #eae7e1; min-height: 26px;"></span>
                  </div>
                  <div style="padding-bottom: 18px;">
                    <div style="font-size: 12.5px; color: #191a1e;">{{ e.text }}</div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a968f; margin-top: 3px;">{{ e.meta }}</div>
                  </div>
                </div>
              </sc-for>
            </div>
          </sc-if>
        </div>
      </sc-if>

      <sc-if value="{{ isWorkflow }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Workflow builder" style="display: grid; grid-template-columns: 1fr 320px; gap: 16px; align-items: start;">
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 16px 20px; display: flex; align-items: center; gap: 14px;">
              <div>
                <div style="font-size: 14px; font-weight: 600;">Standard Enterprise Onboarding</div>
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f; margin-top: 3px;">v4 · applied to 31 projects · edited 2d ago</div>
              </div>
              <div style="flex: 1;"></div>
              <button style="height: 31px; padding: 0 13px; border-radius: 8px; border: 1px solid #e6e3dd; background: #fff; font-family: Archivo, sans-serif; font-size: 12px; cursor: pointer;" style-hover="background: #f7f6f3;">Save as template</button>
              <button onClick="{{ addStage }}" style="height: 31px; padding: 0 13px; border-radius: 8px; border: none; background: oklch(0.52 0.16 274); color: #fff; font-family: Archivo, sans-serif; font-size: 12px; cursor: pointer;" style-hover="background: oklch(0.45 0.16 274);">Add stage</button>
            </div>

            <sc-for list="{{ stages }}" as="s" hint-placeholder-count="9">
              <div onClick="{{ s.select }}" style="{{ s.rowStyle }}">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f; width: 20px;">{{ s.n }}</span>
                <div style="min-width: 0; flex: 1;">
                  <div style="display: flex; align-items: center; gap: 9px;">
                    <span style="font-size: 13px; font-weight: 500;">{{ s.name }}</span>
                    <sc-if value="{{ s.approval }}" hint-placeholder-val="{{ false }}">
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; padding: 2px 6px; border-radius: 20px; background: oklch(0.96 0.05 70); color: oklch(0.48 0.14 70);">APPROVAL</span>
                    </sc-if>
                    <sc-if value="{{ s.auto }}" hint-placeholder-val="{{ false }}">
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; padding: 2px 6px; border-radius: 20px; background: oklch(0.95 0.03 274); color: oklch(0.42 0.16 274);">AUTO</span>
                    </sc-if>
                  </div>
                  <div style="font-size: 11px; color: #75726c; margin-top: 3px;">{{ s.dept }} · SLA {{ s.sla }} · {{ s.scope }}</div>
                  <sc-if value="{{ s.branch }}" hint-placeholder-val="{{ false }}">
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 9px; padding: 7px 10px; border-radius: 8px; background: oklch(0.97 0.02 274); border: 1px solid oklch(0.93 0.03 274);">
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.06em; color: oklch(0.42 0.16 274);">IF</span>
                      <span style="font-size: 11.5px; color: #2b2c31;">{{ s.branch }}</span>
                      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.06em; color: oklch(0.42 0.16 274);">→</span>
                      <span style="font-size: 11.5px; font-weight: 500; color: #2b2c31;">{{ s.branchTo }}</span>
                      <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #9a968f;">else {{ s.branchElse }}</span>
                    </div>
                  </sc-if>
                </div>
                <div style="display: flex; gap: 4px;">
                  <button onClick="{{ s.up }}" style="width: 26px; height: 26px; border-radius: 7px; border: 1px solid #e6e3dd; background: #fff; cursor: pointer; font-size: 10px; color: #75726c;" style-hover="background: #f2f0ec;">▲</button>
                  <button onClick="{{ s.down }}" style="width: 26px; height: 26px; border-radius: 7px; border: 1px solid #e6e3dd; background: #fff; cursor: pointer; font-size: 10px; color: #75726c;" style-hover="background: #f2f0ec;">▼</button>
                  <button onClick="{{ s.remove }}" style="width: 26px; height: 26px; border-radius: 7px; border: 1px solid #e6e3dd; background: #fff; cursor: pointer; font-size: 11px; color: #75726c;" style-hover="background: oklch(0.96 0.04 25); color: oklch(0.5 0.17 25);">✕</button>
                </div>
              </div>
            </sc-for>
          </div>

          <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px; position: sticky; top: 76px;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">Stage configuration</div>
            <div style="font-size: 15px; font-weight: 600; margin-top: 8px;">{{ sel.name }}</div>
            <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 18px;">
              <sc-for list="{{ sel.fields }}" as="f" hint-placeholder-count="5">
                <div>
                  <div style="font-size: 11px; color: #75726c; margin-bottom: 5px;">{{ f.label }}</div>
                  <div style="height: 32px; border: 1px solid #e6e3dd; border-radius: 8px; padding: 0 11px; display: flex; align-items: center; font-size: 12.5px; background: #fdfcfb;">{{ f.value }}</div>
                </div>
              </sc-for>
              <sc-for list="{{ sel.toggles }}" as="t" hint-placeholder-count="3">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="{{ t.track }}"><div style="{{ t.knob }}"></div></div>
                  <span style="font-size: 12px;">{{ t.label }}</span>
                </div>
              </sc-for>
            </div>
            <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid #f4f2ee;">
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">Branch rules</div>
              <sc-for list="{{ sel.branches }}" as="b" hint-placeholder-count="2">
                <div style="border: 1px solid #efece7; border-radius: 9px; padding: 10px 11px; margin-top: 9px; background: #fdfcfb;">
                  <div style="font-size: 11.5px; color: #2b2c31; line-height: 1.5;">{{ b.text }}</div>
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #9a968f; margin-top: 5px;">{{ b.meta }}</div>
                </div>
              </sc-for>
              <button style="width: 100%; height: 30px; margin-top: 9px; border-radius: 8px; border: 1px dashed #ccc7bf; background: transparent; font-family: Archivo, sans-serif; font-size: 11.5px; color: #75726c; cursor: pointer;" style-hover="border-color: #9a968f;">＋ Add condition</button>
            </div>
            <div style="margin-top: 18px; padding-top: 16px; border-top: 1px solid #f4f2ee;">
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">Publishing</div>
              <div style="font-size: 11.5px; color: #75726c; line-height: 1.55; margin-top: 8px;">Publishes as v5. Running cases stay frozen on their current version by default; migrating one is an explicit, reviewed action.</div>
              <div style="display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 10px 12px; border-radius: 9px; background: oklch(0.98 0.02 70); border: 1px solid oklch(0.93 0.04 70);">
                <div style="min-width: 0;">
                  <div style="font-size: 12px; font-weight: 500;">31 cases on v4</div>
                  <div style="font-size: 11px; color: #75726c; margin-top: 2px;">18 eligible to migrate</div>
                </div>
                <button style="margin-left: auto; height: 28px; padding: 0 11px; border-radius: 8px; border: none; background: #191a1e; color: #fff; font-family: Archivo, sans-serif; font-size: 11.5px; cursor: pointer;" style-hover="background: #34363c;">Review migration</button>
              </div>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isReports }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Reports" style="display: flex; flex-direction: column; gap: 16px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <sc-for list="{{ ranges }}" as="r" hint-placeholder-count="3">
              <button onClick="{{ r.pick }}" style="{{ r.style }}">{{ r.label }}</button>
            </sc-for>
            <div style="flex: 1;"></div>
            <sc-for list="{{ exports }}" as="e" hint-placeholder-count="3">
              <button style="height: 30px; padding: 0 12px; border-radius: 8px; border: 1px solid #e6e3dd; background: #fff; font-family: 'IBM Plex Mono', monospace; font-size: 11px; cursor: pointer; color: #4d4a46;" style-hover="background: #f2f0ec;">{{ e }}</button>
            </sc-for>
          </div>

          <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; align-items: start;">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px 20px;">
              <div style="display: flex; align-items: baseline; gap: 12px;">
                <span style="font-size: 13.5px; font-weight: 600;">Average onboarding time</span>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: oklch(0.5 0.12 155);">−6.4 days YoY</span>
              </div>
              <div style="display: flex; align-items: flex-end; gap: 10px; height: 168px; margin-top: 22px;">
                <sc-for list="{{ trend }}" as="t" hint-placeholder-count="8">
                  <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end;">
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #75726c;">{{ t.value }}</span>
                    <div style="{{ t.barStyle }}"></div>
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #9a968f;">{{ t.label }}</span>
                  </div>
                </sc-for>
              </div>
            </div>

            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px 20px;">
              <div style="font-size: 13.5px; font-weight: 600;">Stage bottlenecks</div>
              <div style="font-size: 11.5px; color: #75726c; margin-top: 4px;">Median days in stage vs. SLA</div>
              <div style="display: flex; flex-direction: column; gap: 11px; margin-top: 18px;">
                <sc-for list="{{ bottlenecks }}" as="b" hint-placeholder-count="5">
                  <div>
                    <div style="display: flex; align-items: baseline; margin-bottom: 5px;">
                      <span style="font-size: 12px;">{{ b.stage }}</span>
                      <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: {{ b.ink }};">{{ b.label }}</span>
                    </div>
                    <div style="height: 8px; border-radius: 4px; background: #f4f2ee; overflow: hidden; position: relative;">
                      <div style="{{ b.barStyle }}"></div>
                      <div style="{{ b.slaStyle }}"></div>
                    </div>
                  </div>
                </sc-for>
              </div>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px;">
            <sc-for list="{{ reportCards }}" as="r" hint-placeholder-count="3">
              <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 18px 20px;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 12px;">{{ r.title }}</div>
                <sc-for list="{{ r.rows }}" as="row" hint-placeholder-count="4">
                  <div style="display: flex; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid #f4f2ee;">
                    <span style="font-size: 12px; color: #4d4a46;">{{ row.k }}</span>
                    <span style="margin-left: auto; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: {{ row.ink }};">{{ row.v }}</span>
                  </div>
                </sc-for>
              </div>
            </sc-for>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isPortal }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Customer portal" style="display: flex; flex-direction: column; gap: 16px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 12px; color: #75726c;">External view — Northwind Logistics sees only this.</span>
            <div style="flex: 1;"></div>
            <div style="display: flex; gap: 3px; padding: 3px; border-radius: 9px; background: #ece9e3;">
              <button onClick="{{ setWeb }}" style="{{ webBtn }}">Web</button>
              <button onClick="{{ setMobile }}" style="{{ mobileBtn }}">Mobile</button>
            </div>
          </div>

          <sc-if value="{{ portalWeb }}" hint-placeholder-val="{{ false }}">
            <div style="border: 1px solid #e6e3dd; border-radius: 14px; overflow: hidden; background: #fff;">
              <div style="height: 38px; background: #f2f0ec; border-bottom: 1px solid #e6e3dd; display: flex; align-items: center; gap: 7px; padding: 0 14px;">
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #d6d1c9;"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #d6d1c9;"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #d6d1c9;"></span>
                <span style="margin: 0 auto; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #8a867f;">portal.acme-industrial.com/northwind</span>
              </div>
              <div style="padding: 34px 44px 44px;">
                <div style="display: flex; align-items: flex-start; gap: 24px; flex-wrap: wrap;">
                  <div style="flex: 1; min-width: 260px;">
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.09em; text-transform: uppercase; color: #9a968f;">Your onboarding</div>
                    <div style="font-size: 30px; font-weight: 600; letter-spacing: -0.03em; margin-top: 8px; line-height: 1.15;">You're in Verification</div>
                    <div style="font-size: 13.5px; color: #4d4a46; margin-top: 10px; max-width: 46ch; text-wrap: pretty;">Two documents are still waiting on you. Once those are approved, technical setup starts automatically.</div>
                  </div>
                  <div style="width: 210px;">
                    <div style="display: flex; align-items: baseline; gap: 8px;">
                      <span style="font-size: 34px; font-weight: 600; letter-spacing: -0.03em; line-height: 1;">62%</span>
                      <span style="font-size: 12px; color: #75726c;">complete</span>
                    </div>
                    <div style="height: 8px; border-radius: 5px; background: #f0eee9; overflow: hidden; margin-top: 12px;">
                      <div style="width: 62%; height: 100%; background: oklch(0.52 0.16 274);"></div>
                    </div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #75726c; margin-top: 10px;">Est. go live · 12 Sep 2026</div>
                  </div>
                </div>

                <div style="display: flex; gap: 4px; margin-top: 34px; align-items: flex-start;">
                  <sc-for list="{{ portalSteps }}" as="p" hint-placeholder-count="9">
                    <div style="flex: 1; min-width: 0;">
                      <div style="{{ p.bar }}"></div>
                      <div style="font-size: 11px; color: {{ p.ink }}; margin-top: 9px; line-height: 1.3;">{{ p.label }}</div>
                      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; color: #b0aba3; margin-top: 3px;">{{ p.date }}</div>
                    </div>
                  </sc-for>
                </div>

                <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; margin-top: 38px; align-items: start;">
                  <div style="border: 1px solid oklch(0.9 0.05 70); background: oklch(0.98 0.02 70); border-radius: 13px; padding: 18px 20px;">
                    <div style="font-size: 13.5px; font-weight: 600;">Action needed from you</div>
                    <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 14px;">
                      <sc-for list="{{ portalAsks }}" as="a" hint-placeholder-count="2">
                        <div style="display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid oklch(0.93 0.03 70); border-radius: 10px; padding: 12px 14px;">
                          <div style="min-width: 0; flex: 1;">
                            <div style="font-size: 12.5px; font-weight: 500;">{{ a.name }}</div>
                            <div style="font-size: 11px; color: #75726c; margin-top: 2px;">{{ a.hint }}</div>
                          </div>
                          <button style="height: 30px; padding: 0 13px; border-radius: 8px; border: none; background: #191a1e; color: #fff; font-family: Archivo, sans-serif; font-size: 12px; cursor: pointer;" style-hover="background: #34363c;">Upload</button>
                        </div>
                      </sc-for>
                    </div>
                  </div>
                  <div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">Upcoming</div>
                    <div style="display: flex; flex-direction: column; gap: 0; margin-top: 10px;">
                      <sc-for list="{{ portalUpcoming }}" as="u" hint-placeholder-count="3">
                        <div style="display: flex; gap: 12px; padding: 11px 0; border-bottom: 1px solid #f0eee9;">
                          <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968f; width: 54px; flex: 0 0 54px;">{{ u.date }}</span>
                          <div>
                            <div style="font-size: 12.5px;">{{ u.title }}</div>
                            <div style="font-size: 11px; color: #75726c; margin-top: 2px;">{{ u.sub }}</div>
                          </div>
                        </div>
                      </sc-for>
                    </div>
                    <div style="font-size: 11.5px; color: #75726c; margin-top: 14px; line-height: 1.55;">Questions? Your account manager <strong style="font-weight: 600;">Maria Kessler</strong> replies within a business day.</div>
                  </div>
                </div>
              </div>
            </div>
          </sc-if>

          <sc-if value="{{ portalMobile }}" hint-placeholder-val="{{ false }}">
            <div style="display: flex; gap: 26px; justify-content: center; padding: 10px 0 20px; flex-wrap: wrap;">
              <div style="width: 372px; height: 764px; border-radius: 42px; background: #191a1e; padding: 11px; box-shadow: 0 30px 70px -30px rgba(25,26,30,0.45);">
                <div style="width: 100%; height: 100%; border-radius: 32px; background: #fff; overflow: hidden; display: flex; flex-direction: column;">
                  <div style="height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; flex: 0 0 44px;">
                    <span>9:41</span><span>▮▮▮ ▮</span>
                  </div>
                  <div style="flex: 1; overflow: auto; padding: 6px 20px 24px;">
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; color: #9a968f;">Northwind Logistics</div>
                    <div style="font-size: 23px; font-weight: 600; letter-spacing: -0.02em; margin-top: 7px; line-height: 1.2;">Verification in progress</div>
                    <div style="display: flex; align-items: baseline; gap: 7px; margin-top: 18px;">
                      <span style="font-size: 27px; font-weight: 600; letter-spacing: -0.03em;">62%</span>
                      <span style="font-size: 12px; color: #75726c;">· go live 12 Sep</span>
                    </div>
                    <div style="height: 7px; border-radius: 5px; background: #f0eee9; overflow: hidden; margin-top: 10px;">
                      <div style="width: 62%; height: 100%; background: oklch(0.52 0.16 274);"></div>
                    </div>

                    <div style="border: 1px solid oklch(0.9 0.05 70); background: oklch(0.98 0.02 70); border-radius: 13px; padding: 15px 16px; margin-top: 20px;">
                      <div style="font-size: 12.5px; font-weight: 600;">2 documents needed</div>
                      <sc-for list="{{ portalAsks }}" as="a" hint-placeholder-count="2">
                        <div style="margin-top: 11px;">
                          <div style="font-size: 12px; font-weight: 500;">{{ a.name }}</div>
                          <div style="font-size: 11px; color: #75726c; margin-top: 2px;">{{ a.hint }}</div>
                          <button style="width: 100%; height: 46px; margin-top: 9px; border-radius: 10px; border: none; background: #191a1e; color: #fff; font-family: Archivo, sans-serif; font-size: 13px; font-weight: 500; cursor: pointer;">Upload {{ a.short }}</button>
                        </div>
                      </sc-for>
                    </div>

                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f; margin: 24px 0 10px;">Your journey</div>
                    <sc-for list="{{ portalSteps }}" as="p" hint-placeholder-count="9">
                      <div style="display: flex; gap: 12px; align-items: flex-start;">
                        <div style="display: flex; flex-direction: column; align-items: center; flex: 0 0 18px;">
                          <div style="{{ p.mdot }}"></div>
                          <div style="width: 1px; flex: 1; min-height: 22px; background: #eae7e1;"></div>
                        </div>
                        <div style="padding-bottom: 14px;">
                          <div style="font-size: 12.5px; color: {{ p.ink }}; font-weight: 500;">{{ p.label }}</div>
                          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #b0aba3; margin-top: 2px;">{{ p.date }}</div>
                        </div>
                      </div>
                    </sc-for>
                  </div>
                  <div style="flex: 0 0 62px; border-top: 1px solid #f0eee9; display: flex; align-items: center; justify-content: space-around; padding-bottom: 6px;">
                    <sc-for list="{{ mobileTabs }}" as="t" hint-placeholder-count="4">
                      <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 56px; min-height: 44px; justify-content: center;">
                        <span style="font-size: 15px; color: {{ t.ink }};">{{ t.icon }}</span>
                        <span style="font-size: 10px; color: {{ t.ink }};">{{ t.label }}</span>
                      </div>
                    </sc-for>
                  </div>
                </div>
              </div>

              <div style="width: 300px; padding-top: 12px;">
                <div style="font-size: 13.5px; font-weight: 600;">Mobile principles</div>
                <sc-for list="{{ mobileNotes }}" as="n" hint-placeholder-count="4">
                  <div style="display: flex; gap: 10px; margin-top: 14px;">
                    <span style="width: 5px; height: 5px; border-radius: 50%; background: oklch(0.52 0.16 274); margin-top: 6px; flex: 0 0 5px;"></span>
                    <span style="font-size: 12px; color: #4d4a46; line-height: 1.55;">{{ n }}</span>
                  </div>
                </sc-for>
              </div>
            </div>
          </sc-if>
        </div>
      </sc-if>

      <sc-if value="{{ isNotes }}" hint-placeholder-val="{{ false }}">
        <div data-screen-label="Design notes" style="max-width: 1020px; display: flex; flex-direction: column; gap: 22px;">
          <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 26px 28px;">
            <div style="font-size: 18px; font-weight: 600; letter-spacing: -0.02em;">Design decisions</div>
            <div style="font-size: 13px; color: #4d4a46; margin-top: 8px; max-width: 68ch; line-height: 1.6; text-wrap: pretty;">The PRD describes eleven feature areas. Rather than one screen per area, the design collapses them into a single object — the onboarding case — and lets each area appear as a facet of it. That keeps the surface small enough to learn in one sitting while still covering every requirement.</div>
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; margin-top: 24px;">
              <sc-for list="{{ decisions }}" as="d" hint-placeholder-count="6">
                <div style="border-top: 1px solid #efece7; padding-top: 14px;">
                  <div style="font-size: 13px; font-weight: 600;">{{ d.title }}</div>
                  <div style="font-size: 12px; color: #4d4a46; line-height: 1.6; margin-top: 6px;">{{ d.body }}</div>
                </div>
              </sc-for>
            </div>
          </div>

          <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; overflow: hidden;">
            <div style="padding: 18px 24px 14px; font-size: 15px; font-weight: 600;">PRD coverage</div>
            <div style="display: grid; grid-template-columns: 0.5fr 1.4fr 2fr 0.8fr; gap: 14px; padding: 10px 24px; background: #faf9f7; border-top: 1px solid #e6e3dd; border-bottom: 1px solid #e6e3dd; font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a968f;">
              <span>§</span><span>Requirement</span><span>Where it lives</span><span>State</span>
            </div>
            <sc-for list="{{ coverage }}" as="c" hint-placeholder-count="12">
              <div style="display: grid; grid-template-columns: 0.5fr 1.4fr 2fr 0.8fr; gap: 14px; align-items: baseline; padding: 10px 24px; border-bottom: 1px solid #f4f2ee;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #9a968f;">{{ c.sec }}</span>
                <span style="font-size: 12.5px; font-weight: 500;">{{ c.req }}</span>
                <span style="font-size: 12px; color: #4d4a46;">{{ c.where }}</span>
                <span style="{{ c.pill }}">{{ c.state }}</span>
              </div>
            </sc-for>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start;">
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 22px 24px;">
              <div style="font-size: 15px; font-weight: 600;">Resolved · answers from product</div>
              <sc-for list="{{ questions }}" as="q" hint-placeholder-count="5">
                <div style="display: flex; gap: 11px; margin-top: 15px; padding-top: 13px; border-top: 1px solid #f4f2ee;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: oklch(0.52 0.16 274); flex: 0 0 18px;">{{ q.n }}</span>
                  <div style="min-width: 0;">
                    <div style="font-size: 12px; font-weight: 600; color: #191a1e; line-height: 1.5;">{{ q.answer }}</div>
                    <div style="font-size: 12px; color: #4d4a46; line-height: 1.55; margin-top: 4px;">{{ q.impact }}</div>
                  </div>
                </div>
              </sc-for>
            </div>
            <div style="background: #fff; border: 1px solid #e6e3dd; border-radius: 13px; padding: 22px 24px;">
              <div style="font-size: 15px; font-weight: 600;">Design language</div>
              <sc-for list="{{ language }}" as="l" hint-placeholder-count="5">
                <div style="display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 11px 0; border-bottom: 1px solid #f4f2ee;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: #9a968f; padding-top: 2px;">{{ l.k }}</span>
                  <span style="font-size: 12px; color: #2b2c31; line-height: 1.55;">{{ l.v }}</span>
                </div>
              </sc-for>
            </div>
          </div>
        </div>
      </sc-if>

    </div>
  </main>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;density&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;comfortable&quot;,&quot;compact&quot;],&quot;default&quot;:&quot;comfortable&quot;,&quot;tsType&quot;:&quot;'comfortable' | 'compact'&quot;,&quot;section&quot;:&quot;Layout&quot;},&quot;railTheme&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;dark&quot;,&quot;light&quot;],&quot;default&quot;:&quot;dark&quot;,&quot;tsType&quot;:&quot;'dark' | 'light'&quot;,&quot;section&quot;:&quot;Layout&quot;},&quot;liveFeed&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Behavior&quot;}}">
const ACC = 'oklch(0.52 0.16 274)';
const GRN = 'oklch(0.6 0.12 155)';
const AMB = 'oklch(0.72 0.14 70)';
const RED = 'oklch(0.57 0.17 25)';
const MUT = '#75726c';

function pill(bg, ink) {
  return 'font-family: \'IBM Plex Mono\', monospace; font-size: 9.5px; letter-spacing: 0.05em; text-transform: uppercase; padding: 3px 8px; border-radius: 20px; white-space: nowrap; background: ' + bg + '; color: ' + ink + ';';
}
const PILLS = {
  done: pill('oklch(0.95 0.04 155)', 'oklch(0.45 0.12 155)'),
  active: pill('oklch(0.95 0.03 274)', 'oklch(0.42 0.16 274)'),
  blocked: pill('oklch(0.96 0.04 25)', 'oklch(0.5 0.17 25)'),
  wait: pill('oklch(0.96 0.05 70)', 'oklch(0.46 0.14 70)'),
  idle: pill('#f2f0ec', '#75726c')
};
function dot(color, size) {
  const s = size || 8;
  return 'width: ' + s + 'px; height: ' + s + 'px; flex: 0 0 ' + s + 'px; border-radius: 50%; background: ' + color + ';';
}
function bar(pct, color, h) {
  return 'width: ' + pct + '%; height: ' + (h || 100) + (h ? 'px' : '%') + '; background: ' + color + '; border-radius: 4px; transition: width 0.4s ease;';
}

const STAGE_NAMES = ['Registration', 'Sales Approval', 'Agreement', 'Document Collection', 'Verification', 'Technical Setup', 'Testing', 'Training', 'Go Live'];

class Component extends DCLogic {
  state = {
    screen: 'dash',
    role: 'internal',
    tab: 'journey',
    filter: 'All',
    range: '90 days',
    open: { verification: true },
    doneTasks: {},
    portalDevice: 'web',
    selStage: 4,
    notifOpen: false,
    caseId: 'ONB-2026-0341',
    stages: STAGE_NAMES.map((n, i) => ({
      name: n,
      dept: ['Sales', 'Sales', 'Legal', 'Operations', 'Compliance', 'Technical', 'Technical', 'Support', 'Account Mgmt'][i],
      sla: ['1d', '2d', '5d', '7d', '4d', '10d', '5d', '3d', '1d'][i],
      approval: [false, true, true, false, true, false, false, false, true][i],
      auto: [true, false, false, false, false, true, false, false, false][i],
      scope: ['Owner + Sales', 'Owner + Sales leads', 'Legal on this case', 'Owner + assigned ops', 'Compliance on this case', 'Assigned engineers', 'Assigned engineers', 'Support on this case', 'Owner only'][i],
      branch: ['', 'Deal value > €500k', '', '', 'Enhanced due diligence flagged', 'Integration type = EDI', '', '', ''][i],
      branchTo: ['', 'Executive Approval', '', '', 'Enhanced KYC Review', 'EDI Provisioning', '', '', ''][i],
      branchElse: ['', 'continue', '', '', 'skip to Technical Setup', 'API Provisioning', '', '', ''][i]
    })),
    tick: 0
  };

  componentDidMount() {
    if (this.props.liveFeed === false) return;
    this._t = setInterval(() => this.setState(s => ({ tick: s.tick + 1 })), 3200);
  }
  componentWillUnmount() { clearInterval(this._t); }

  go = (screen) => () => this.setState({ screen: screen, notifOpen: false });

  navStyle(active) {
    return 'display: flex; align-items: center; gap: 11px; width: 100%; padding: 8px 11px; border: none; border-radius: 9px; cursor: pointer; font-family: Archivo, sans-serif; font-size: 13px; text-align: left; color: inherit; background: ' + (active ? 'rgba(255,255,255,0.11)' : 'transparent') + '; opacity: ' + (active ? '1' : '0.72') + '; font-weight: ' + (active ? '500' : '400') + ';';
  }
  segStyle(active) {
    return 'flex: 1; height: 27px; border: none; border-radius: 7px; cursor: pointer; font-family: Archivo, sans-serif; font-size: 11.5px; color: ' + (active ? '#191a1e' : 'inherit') + '; background: ' + (active ? '#fff' : 'transparent') + '; opacity: ' + (active ? '1' : '0.7') + ';';
  }
  chipStyle(active) {
    return 'height: 30px; padding: 0 13px; border-radius: 8px; cursor: pointer; font-family: Archivo, sans-serif; font-size: 12px; border: 1px solid ' + (active ? '#191a1e' : '#e6e3dd') + '; background: ' + (active ? '#191a1e' : '#fff') + '; color: ' + (active ? '#fff' : '#4d4a46') + ';';
  }
  tabStyle(active) {
    return 'padding: 9px 15px 11px; border: none; background: transparent; cursor: pointer; font-family: Archivo, sans-serif; font-size: 13px; color: ' + (active ? '#191a1e' : MUT) + '; font-weight: ' + (active ? '600' : '400') + '; box-shadow: ' + (active ? 'inset 0 -2px 0 ' + ACC : 'none') + ';';
  }

  toggleTask = (id) => () => this.setState(s => ({ doneTasks: Object.assign({}, s.doneTasks, { [id]: !s.doneTasks[id] }) }));
  toggleM = (key) => () => this.setState(s => ({ open: Object.assign({}, s.open, { [key]: !s.open[key] }) }));

  moveStage = (i, d) => () => this.setState(s => {
    const arr = s.stages.slice();
    const j = i + d;
    if (j < 0 || j >= arr.length) return null;
    const tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    return { stages: arr, selStage: j };
  });
  removeStage = (i) => (e) => { e.stopPropagation(); this.setState(s => ({ stages: s.stages.filter((_, k) => k !== i), selStage: Math.min(s.selStage, s.stages.length - 2) })); };
  addStage = () => this.setState(s => ({ stages: s.stages.concat([{ name: 'New stage', dept: 'Unassigned', sla: '3d', approval: false, auto: false }]), selStage: s.stages.length }));

  taskRow(t) {
    const done = this.state.doneTasks[t.id] !== undefined ? this.state.doneTasks[t.id] : t.done;
    const status = done ? 'Completed' : t.status;
    return Object.assign({}, t, {
      toggle: this.toggleTask(t.id),
      check: done ? '✓' : '',
      box: 'width: 17px; height: 17px; flex: 0 0 17px; border-radius: 5px; cursor: pointer; display: grid; place-items: center; font-size: 10px; padding: 0; color: #fff; border: 1px solid ' + (done ? GRN : '#d6d1c9') + '; background: ' + (done ? GRN : '#fff') + ';',
      titleStyle: 'font-size: 12.5px; color: ' + (done ? '#9a968f' : '#191a1e') + '; text-decoration: ' + (done ? 'line-through' : 'none') + ';',
      status: status,
      statusPill: done ? PILLS.done : (t.status === 'In Progress' ? PILLS.active : t.status === 'Waiting' ? PILLS.wait : PILLS.idle),
      prio: t.priority === 'High' ? pill('oklch(0.96 0.04 25)', 'oklch(0.5 0.17 25)') : t.priority === 'Med' ? pill('oklch(0.96 0.05 70)', 'oklch(0.46 0.14 70)') : pill('#f2f0ec', '#75726c'),
      dueColor: t.overdue && !done ? RED : '#4d4a46'
    });
  }

