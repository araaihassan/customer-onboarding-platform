        { title: 'Non-Disclosure Agreement', meta: 'NDA-0341-v1 · mutual', status: 'Under review', st: 'active', expiry: 'With customer legal since 09 Aug', action: 'Nudge', stepsDone: 2 }
      ].map(a => Object.assign({}, a, {
